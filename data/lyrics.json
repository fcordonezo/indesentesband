        {
          "timeStart": 65,
          "timeEnd": 69,
          "parts": [
            {
              "text": "No es que pierda la cabeza de repente"
            }
          ]
        },
        {
          "timeStart": 69,
          "timeEnd": 75,
          "parts": [
            {
              "text": "No es que pierda la necesidad de sentir"
            }
          ]
        },
        {
          "timeStart": 75,
          "timeEnd": 84,
          "parts": [
            {
              "text": "Se me escapa el tiempo entre las "
            },
            {
              "text": "manecillas de un reloj que está por estallar",
              "voices": [
                "main",
                "backing"
              ]
            }
          ]
        },
        {
          "timeStart": 85,
          "timeEnd": 93,
          "parts": [
            {
              "text": "No es difícil entender "
            },
            {
              "text": "que el destino siempre a la suerte",
              "voices": [
