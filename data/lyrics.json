      "id": "s1",
      "lyrics": [
        {
          "timeStart": 92,
          "timeEnd": 102,
          "parts": [
            {
              "text": "No queda más que aceptar mi responsabilidad, si es lo que quiere"
            }
          ]
        },
        {
          "timeStart": 102,
          "timeEnd": 108,
          "parts": [
            {
              "text": "En ocasiones sientes que tu vida no va más"
            }
          ]
        },
        {
          "timeStart": 108,
          "timeEnd": 112,
          "parts": [
            {
              "text": "que no hay rumbo ni futuro",
              "voices": [
                "main",
                "backing"
              ]
            }
          ]
        },
        {
          "timeStart": 112,
          "timeEnd": 117,
          "parts": [
            {
              "text": "Cerrar los ojos es lo que quieres"
            }
          ]
        },
        {
          "timeStart": 119,
          "timeEnd": 127,
          "parts": [
            {
              "text": "Abrirlos cuando ya todo haya terminado y ya nada"
            }
          ]
        },
        {
          "timeStart": 128,
          "timeEnd": 131,
          "parts": [
            {
              "text": "y ya nada se pueda hacer",
              "voices": [
                "main",
                "backing"
              ]
            }
          ]
        },
        {
          "timeStart": 154,
          "timeEnd": 163,
          "parts": [
            {
              "text": "No ser trofeo para luego fundirme con asfalto y ser pisoteado"
            }
          ]
        },
        {
          "timeStart": 164,
          "timeEnd": 173,
          "parts": [
            {
              "text": "a cada paso debajo de las enormes industrias"
            }
          ]
        },
        {
          "timeStart": 173,
          "timeEnd": 179,
          "parts": [
            {
              "text": "No es lo que quiero yo, no es lo que yo pedí"
            }
          ]
        },
        {
          "timeStart": 184,
          "timeEnd": 195,
          "parts": [
            {
              "text": "Las palabras de la gente me resbalan siempre y cuando "
            },
            {
              "text": "no toquen mi alma",
              "voices": [
                "main",
                "backing"
              ]
            }
          ]
        },
        {
          "timeStart": 197,
          "timeEnd": 201,
          "parts": [
            {
              "text": "A ver "
            },
            {
              "text": "si me dejan respirar",
              "voices": [
                "main",
                "backing"
              ]
            }
          ]
        },
        {
          "timeStart": 202,
          "timeEnd": 208,
          "parts": [
            {
              "text": "a ver si hago igual que los demás",
              "voices": [
                "main",
                "backing"
              ]
            }
          ]
        },
        {
          "timeStart": 208,
          "timeEnd": 215,
          "parts": [
            {
              "text": "Y dejar mi suerte a la de Dios",
              "voices": [
                "main",
