      "lyrics": [
        {
          "timeStart": 37,
          "timeEnd": 46,
          "parts": [
            {
              "text": "Si me pierdo en el rincón de los sueños reprimidos, es cuestión de inculcarte "
            },
            {
              "text": "qué está bien y qué está mal",
              "voices": [
                "main",
                "backing"
              ]
            }
          ]
        },
        {
          "timeStart": 47,
          "timeEnd": 55,
          "parts": [
            {
              "text": "Madrugaste, se hizo tarde. La ruta de esa vida a todo sera igual"
            }
          ]
        },
        {
          "timeStart": 56,
          "timeEnd": 61,
          "parts": [
            {
              "text": "¿Cuál es siempre el mismo problema? ¿Cuál es?"
            }
          ]
        },
        {
          "timeStart": 62,
          "timeEnd": 65,
          "parts": [
            {
              "text": "Siempre es igualdad"
